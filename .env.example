# Copy to .env for local dev, or set as build env var in Vercel/Netlify/Railway

# Local dev (TheShop server running on your machine):
VITE_API_URL=http://localhost:4000

# Production examples:
# Railway:  VITE_API_URL=https://theshop-server-production.up.railway.app
# Render:   VITE_API_URL=https://theshop-server.onrender.com
# VPS:      VITE_API_URL=https://api.yourshop.com
